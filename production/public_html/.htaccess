RewriteEngine On

# ============================================================
# BOYKOVDOCS ROUTING V2
# ============================================================

# ------------------------------------------------------------
# 1. Backend API -> Passenger / Node.js
# ------------------------------------------------------------

RewriteRule ^api(?:/|$) - [L,NC]


# ------------------------------------------------------------
# 2. Публичные серверные SEO-маршруты
#
# Их должен обрабатывать Node.js, а не React index.html.
# ------------------------------------------------------------

RewriteRule ^robots\.txt$ - [L,NC]

RewriteRule ^sitemap\.xml$ - [L,NC]

RewriteRule ^instrukcii-po-ohrane-truda/?$ - [L,NC]

RewriteRule ^instrukciya-po-ohrane-truda/[^/]+/?$ - [L,NC]

RewriteRule ^thanks/?$ - [L,NC]


# ------------------------------------------------------------
# 3. Реальные существующие файлы и каталоги
# ------------------------------------------------------------

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]


# ------------------------------------------------------------
# 4. Подтверждённые клиентские страницы React
# ------------------------------------------------------------

RewriteRule ^(?:offer|privacy|personal-data-consent)/?$ index.html [L,NC]


# ------------------------------------------------------------
# 5. ВАЖНО
#
# Здесь намеренно НЕТ:
#
# RewriteRule ^ index.html [L]
#
# Любой другой неизвестный URL проходит дальше в Passenger,
# где Node.js возвращает настоящий HTTP 404.
# ------------------------------------------------------------
